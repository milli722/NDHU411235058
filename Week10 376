class Solution {
public:
    int wiggleMaxLength(vector<int>& nums) {
        int n = nums.size();
        if (n < 2) return n;
        int prev = 0;
        int curr = 0;
        int count = 1;
        for (int i = 0; i < n - 1; i++) {
            curr = nums[i + 1] - nums[i];
            if ((prev <= 0 && curr > 0) || (prev >= 0 && curr < 0)) {
                count++;
                prev = curr;
            }
        }
        return count;
    }
};
